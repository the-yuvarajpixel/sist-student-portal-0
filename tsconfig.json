{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    "declaration": false,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "exclude": ["dist"]
}
